generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  BASE
  PRO
  ULTRA
  BUSINESS
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  avatarUrl     String?
  role          Role      @default(USER)
  plan          Plan      @default(FREE)
  tokenBalance  BigInt    @default(0)
  planExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  transactions  Transaction[]
  messages      Message[]
  chats         Chat[]
  payments      Payment[]
}

model Chat {
  id           String    @id @default(cuid())
  userId       String
  title        String    @default("Новый чат")
  model        String
  systemPrompt String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  isArchived   Boolean   @default(false)

  user         User      @relation(fields: [userId], references: [id])
  messages     Message[]
}

model Message {
  id               String   @id @default(cuid())
  chatId           String
  userId           String
  role             String
  content          String   @db.Text
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  costRub          Float    @default(0)
  createdAt        DateTime @default(now())

  chat             Chat     @relation(fields: [chatId], references: [id])
  user             User     @relation(fields: [userId], references: [id])
}

model Payment {
  id            String        @id @default(cuid())
  userId        String
  amount        Int
  tokensGranted BigInt
  plan          Plan?
  yookassaId    String?       @unique
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  completedAt   DateTime?

  user          User          @relation(fields: [userId], references: [id])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        String
  tokens      BigInt
  description String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model PlanConfig {
  id             String  @id
  name           String
  priceRub       Int
  tokensPerMonth BigInt
  description    String
  isActive       Boolean @default(true)
}

model ModelConfig {
  id                String  @id
  displayName       String
  provider          String
  isEnabled         Boolean @default(true)
  minPlan           Plan    @default(FREE)
  markupFactor      Float   @default(2.0)
  inputPrice        Float
  outputPrice       Float
  maxTokens         Int     @default(4096)
  supportsImages    Boolean @default(false)
  supportsWebSearch Boolean @default(false)
}
