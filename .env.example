NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://elbrusway.ru
NEXT_PUBLIC_APP_NAME=ElbrusWay AI

DATABASE_URL=postgresql://user:password@localhost:5432/elbrusway
REDIS_URL=redis://localhost:6379

NEXTAUTH_SECRET=minimum_32_chars_random_string
NEXTAUTH_URL=https://elbrusway.ru
JWT_SECRET=another_32_chars_random_string

ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
ROUTERAI_DEFAULT_MODEL=google/gemini-2.5-flash
ROUTERAI_PROVIDER_COUNTRY=ru
ROUTERAI_MODELS_CACHE_TTL_SEC=600
ROUTERAI_IMAGE_MODEL=
ROUTERAI_AUDIO_MODEL=
ROUTERAI_VISION_MODEL=
ROUTERAI_VIDEO_MODEL=

# Лимиты расходов (оставить пустыми = без лимитов)
SPENDING_LIMIT_RUB_PER_REQUEST=
SPENDING_LIMIT_RUB_PER_USER_PER_DAY=
SPENDING_LIMIT_RUB_PER_DAY=

# Рекомендуемые значения для старта:
# SPENDING_LIMIT_RUB_PER_REQUEST=50
# SPENDING_LIMIT_RUB_PER_USER_PER_DAY=500
# SPENDING_LIMIT_RUB_PER_DAY=5000

PLATEGA_BASE_URL=https://app.platega.io
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET_KEY=
PLATEGA_PAYMENT_METHOD=2

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=

SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=noreply@elbrusway.ru
SMTP_PASS=

S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=elbrusway-uploads
UPLOAD_STORAGE_DIR=/root/MiniAppElbrusWay/storage/uploads
MAX_UPLOAD_SIZE_MB=25
SEARCH_FETCH_LIMIT=5
SEARCH_REQUEST_TIMEOUT_MS=15000
EXPORT_STORAGE_DIR=/root/MiniAppElbrusWay/storage/exports
TOOL_JOB_TIMEOUT_MS=60000
TOOL_JOB_MAX_ATTEMPTS=2

ADMIN_EMAIL=admin@elbrusway.ru
ADMIN_PASSWORD=Admin12345!
